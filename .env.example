# Copy this file to .env.local for local development.
# On Vercel, set these under Project Settings -> Environment Variables.

# Auto-created when you enable "Blob" storage for this project in the
# Vercel dashboard (Storage tab -> Create Database -> Blob -> Connect
# to this project). Required for the Notices page uploads to work.
BLOB_READ_WRITE_TOKEN=

# A password you choose to protect /notices/admin. Anyone who knows this
# password can publish/delete notices, so keep it private and set a
# strong value in Vercel's environment variables (not committed here).
NOTICES_ADMIN_PASSWORD=

# Copy this file to .env.local for local development.
# On Vercel, set these under Project Settings -> Environment Variables.

# Auto-created when you enable "Blob" storage for this project in the
# Vercel dashboard (Storage tab -> Create Database -> Blob -> Connect
# to this project). Required for the Notices page uploads to work.
# Newer Vercel projects auto-inject BLOB_STORE_ID + VERCEL_OIDC_TOKEN
# instead of a static token - in that case you don't need to set
# anything here, the @vercel/blob SDK picks it up automatically on
# Vercel. BLOB_READ_WRITE_TOKEN below is only needed for local dev or
# older-style Blob stores.
BLOB_READ_WRITE_TOKEN=

# The CMS login password for school staff (used at /admin/login to manage
# notices). Anyone who knows this password can sign in and publish/delete
# notices, so keep it private and set a strong value in Vercel's
# environment variables (not committed here).
ADMIN_PASSWORD=
